# Choose and configure only the providers used by the app you run.
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b
BROWSERBASE_API_KEY=
BAYMAX_VOICE_BACKEND=local
# Optional voice tuning. The USB TTS bridge defaults to a cheerful macOS voice;
# Gemini's upbeat Puck voice is used when BAYMAX_VOICE_BACKEND=gemini.
BAYMAX_TTS_VOICE="Eddy (English (US))"
BAYMAX_TTS_RATE=178
BAYMAX_TTS_PITCH=4
BAYMAX_GEMINI_VOICE=Puck
WHISPER_CPP_BIN=/home/bracketbot/.local/share/whisper.cpp/build/bin/whisper-cli
WHISPER_CPP_MODEL=/home/bracketbot/.local/share/whisper.cpp/models/ggml-base.en.bin
# Persistent reminders default to ~/.local/state/bracketbot/reminders.sqlite3.
# Use an IANA timezone name so daylight-saving transitions are handled correctly.
BAYMAX_REMINDER_DB_PATH=
BAYMAX_TIMEZONE=America/Toronto

# Future orchestrator defaults.
BAYMAX_LLM_PROVIDER=gemini
BAYMAX_SSH_HOSTS=botwifi,bracketbot@bracketbot-184.local,bot
